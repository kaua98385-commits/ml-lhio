  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node tools/serve.mjs",
    "data": "node tools/fetch-geodata.mjs && node tools/build-geodata.mjs",
    "data:fetch": "node tools/fetch-geodata.mjs",
    "data:build": "node tools/build-geodata.mjs",
    "test": "node --test \"tests/unit/*.test.js\"",
