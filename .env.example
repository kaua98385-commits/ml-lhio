# Copie para .env e preencha (ou exporte as variáveis no shell/hospedagem). O arquivo .env NÃO deve ser publicado.
# URL do projeto Supabase (Project Settings > API > Project URL)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave PÚBLICA (anon ou publishable). Nunca use service_role / sb_secret_ aqui.
SUPABASE_ANON_KEY=
# Endereço público do jogo (usado nos links dos e-mails). Deve estar em Authentication > URL Configuration > Redirect URLs.
SITE_URL=http://localhost:8080
# true (padrão quando há conta configurada): login obrigatório. false: login opcional, modo local continua disponível.
AUTH_REQUIRED=true
